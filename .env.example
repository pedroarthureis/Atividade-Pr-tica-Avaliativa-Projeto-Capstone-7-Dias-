# Configurações do Servidor
PORT=3000
NODE_ENV=development

# Configurações de Banco de Dados
DB_STORAGE=:memory:

# Gateway Anti-Fraude Externo Fictício
ANTI_FRAUD_GATEWAY_URL=https://fraud-gateway.internal.bank.com/v1/analyze
ANTI_FRAUD_API_KEY=mock-anti-fraud-key-sec-12345
ANTI_FRAUD_TIMEOUT_MS=3000

# Gateway de Câmbio / Validação Cadastral (KYC)
KYC_GATEWAY_URL=https://kyc-service.internal.bank.com/v1/compliance
KYC_API_KEY=mock-kyc-key-abc-67890

# Limiares de Negócio
HIGH_VALUE_TRANSACTION_THRESHOLD=5000.00
IDEMPOTENCY_TTL_SECONDS=86400
